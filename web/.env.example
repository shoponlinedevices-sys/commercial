# API Configuration for Web Application
# Copy this file to .env.local and update with your actual values

# Gateway URL (port 4000) - primary endpoint for auth, cart, orders, notifications
NEXT_PUBLIC_GATEWAY=https://api.thegioithietbi.online

# Microservice URLs (fallback direct access)
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:3006
NEXT_PUBLIC_PRODUCTS_SERVICE_URL=http://localhost:3003
NEXT_PUBLIC_SALES_SERVICE_URL=http://localhost:3001
NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=http://localhost:3002
NEXT_PUBLIC_ORDERS_SERVICE_URL=http://localhost:3001

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3009
NEXT_PUBLIC_APP_NAME=Commercial Web App

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG_MODE=false

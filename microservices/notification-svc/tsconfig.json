{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "target": "ES2021",

    "sourceMap": true,

    "outDir": "./dist",

    "baseUrl": "./",
    "paths": {
      "@entities/*": ["../../packages/entities/*"]
    },

    "incremental": true,

    "skipLibCheck": true,

    "resolveJsonModule": true
  },

  "include": ["src/**/*"],

  "exclude": ["node_modules", "dist"]
}